{
  "name": "memory-history-web",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:native": "tsc --noEmit && vite build --mode native",
    "preview": "vite preview",
    "export": "node tools/export.mjs",
    "media": "node tools/media.mjs",
    "content": "npm run export && npm run media",
    "pack": "node tools/pack.mjs",
    "flags": "node tools/flags.mjs",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:ios": "npm run build:native && npx cap sync ios && npx cap open ios",
    "cap:android": "npm run build:native && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@supabase/supabase-js": "^2.112.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "js-yaml": "^4.1.0",
    "sharp": "^0.33.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
