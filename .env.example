# Create a project at https://supabase.com — then paste Project URL + anon key.
# Vite only exposes variables prefixed with VITE_.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Ko-fi donate page (https only). Leave empty to hide the Donate button.
VITE_KOFI_URL=https://ko-fi.com/YOUR_PAGE
