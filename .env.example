# Create a project at https://supabase.com — then paste Project URL + anon key.
# Vite only exposes variables prefixed with VITE_.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY


# Optional: internal email domain for username-only accounts (never receives mail).
# VITE_USERNAME_EMAIL_DOMAIN=users.memoryhistory.app
